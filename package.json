{
  "name": "ftc-reference",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p apps/sync && tsc -p apps/web",
    "lint": "biome check .",
    "db:migrate:local": "pnpm --filter @ftcref/sync exec wrangler d1 migrations apply ftcref --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "pnpm --filter @ftcref/sync exec wrangler d1 migrations apply ftcref --remote",
    "dev:sync": "pnpm --filter @ftcref/sync dev",
    "dev:web": "pnpm --filter @ftcref/web dev",
    "deploy": "pnpm --filter @ftcref/sync deploy && pnpm --filter @ftcref/web deploy",
    "deploy:stage": "pnpm --filter @ftcref/web deploy:stage",
    "avatars:instagram": "node scripts/instagram-avatars.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": ">=4.20250101.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.100.0"
  }
}
