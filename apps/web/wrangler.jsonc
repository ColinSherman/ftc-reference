{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ftcref-web",
  // Personal Cloudflare account — never the team 4201 account.
  "account_id": "a92ff6c4b72094e5030585f2363b940a",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Custom Domains create the DNS records + certs automatically. www 301s to the apex (see index.tsx).
  "routes": [
    { "pattern": "ftc-reference.com", "custom_domain": true },
    { "pattern": "www.ftc-reference.com", "custom_domain": true }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ftcref",
      "database_id": "dae5a37a-cc72-4231-994a-546e0300df1b",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Deploy version id is part of the HTML cache key, so each deploy serves fresh markup.
  "version_metadata": { "binding": "CF_VERSION" },
  "kv_namespaces": [{ "binding": "CACHE_VER", "id": "ec6ff98747db4745ba7351828af13944" }],
  // Admin "Re-sync event" sends jobs straight to the sync Worker's queue. vars/queues are not inherited:
  // the staging env below sets its own.
  "vars": { "ENV_NAME": "production" },
  "queues": { "producers": [{ "binding": "SYNC_QUEUE", "queue": "ftcref-sync-jobs" }] },
  // Sign-in and account data live in ftcref-account (apps/account); this Worker only forwards to it.
  "services": [{ "binding": "ACCOUNT", "service": "ftcref-account" }],

  // `wrangler deploy --env staging` -> stage.ftc-reference.com. Separate Worker AND separate data: it reads
  // the staging D1/KV that ftcref-sync-stage writes (a copy of production, see scripts/stage-seed.mjs).
  // It must never bind a production resource. Ids are shared with apps/sync's staging env.
  // /admin needs no secret: admins sign in (ADMIN_ACCOUNTS in apps/account/wrangler.jsonc).
  "env": {
    "staging": {
      "name": "ftcref-web-stage",
      "account_id": "a92ff6c4b72094e5030585f2363b940a",
      "workers_dev": true,
      "routes": [{ "pattern": "stage.ftc-reference.com", "custom_domain": true }],
      "observability": { "enabled": true, "head_sampling_rate": 0.1 },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ftcref-stage",
          "database_id": "2c5d75b6-bb63-44c3-83f6-9aaf24658a74",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "version_metadata": { "binding": "CF_VERSION" },
      "kv_namespaces": [{ "binding": "CACHE_VER", "id": "3e819b0648c04641a586463e186bbe5b" }],
      "vars": { "ENV_NAME": "staging" },
      "queues": { "producers": [{ "binding": "SYNC_QUEUE", "queue": "ftcref-stage-sync-jobs" }] },
      "services": [{ "binding": "ACCOUNT", "service": "ftcref-account-stage" }]
    }
  }
}
