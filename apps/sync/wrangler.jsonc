{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ftcref-sync",
  // Personal Cloudflare account — never the team 4201 account.
  "account_id": "a92ff6c4b72094e5030585f2363b940a",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "triggers": {
    "crons": ["* * * * *", "0 */6 * * *", "30 9 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ftcref",
      "database_id": "dae5a37a-cc72-4231-994a-546e0300df1b",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Which consumer queue is the throttled backfill one (vars are not inherited: set per env).
  "vars": { "BACKFILL_QUEUE_NAME": "ftcref-backfill" },
  // Enable R2 in the dashboard, run `wrangler r2 bucket create ftcref-raw`, then uncomment:
  // "r2_buckets": [{ "binding": "RAW", "bucket_name": "ftcref-raw" }],
  "kv_namespaces": [{ "binding": "CACHE_VER", "id": "ec6ff98747db4745ba7351828af13944" }],

  "queues": {
    "producers": [
      { "binding": "SYNC_QUEUE", "queue": "ftcref-sync-jobs" },
      { "binding": "BACKFILL_QUEUE", "queue": "ftcref-backfill" }
    ],
    "consumers": [
      {
        "queue": "ftcref-sync-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        // Keeps us polite to the FTC API: at most ~4 jobs in flight account-wide.
        "max_concurrency": 4,
        "max_retries": 5,
        "dead_letter_queue": "ftcref-sync-dlq"
      },
      {
        // Historical seasons: two consumers × ≤5 req/s each (shared throttle per batch, in code).
        "queue": "ftcref-backfill",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 2,
        "max_retries": 4,
        "dead_letter_queue": "ftcref-sync-dlq"
      }
    ]
  },

  // Secrets (wrangler secret put …): FTC_API_USER, FTC_API_TOKEN, ADMIN_TOKEN

  // `wrangler deploy --env staging` -> ftcref-sync-stage. Own D1, KV and queues: it must never bind a
  // production resource. No cron: staging data is a copy of production (scripts/stage-seed.mjs), and
  // events are re-synced on demand (POST /admin/sync-event, or `stage-resync:` lines in a PR body).
  // The *_STAGE_* placeholders are filled by scripts/stage-resources.mjs; commit the real ids it prints.
  // Secrets: `wrangler secret put FTC_API_USER --env staging` (and FTC_API_TOKEN). CI sets ADMIN_TOKEN.
  "env": {
    "staging": {
      "name": "ftcref-sync-stage",
      "account_id": "a92ff6c4b72094e5030585f2363b940a",
      "workers_dev": true,
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "triggers": { "crons": [] },
      "vars": { "BACKFILL_QUEUE_NAME": "ftcref-stage-backfill" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ftcref-stage",
          "database_id": "__STAGE_D1_ID__",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "CACHE_VER", "id": "__STAGE_KV_ID__" }],
      "queues": {
        "producers": [
          { "binding": "SYNC_QUEUE", "queue": "ftcref-stage-sync-jobs" },
          { "binding": "BACKFILL_QUEUE", "queue": "ftcref-stage-backfill" }
        ],
        "consumers": [
          {
            "queue": "ftcref-stage-sync-jobs",
            "max_batch_size": 5,
            "max_batch_timeout": 2,
            "max_concurrency": 2,
            "max_retries": 5,
            "dead_letter_queue": "ftcref-stage-dlq"
          },
          {
            "queue": "ftcref-stage-backfill",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_concurrency": 1,
            "max_retries": 4,
            "dead_letter_queue": "ftcref-stage-dlq"
          }
        ]
      }
    }
  }
}
